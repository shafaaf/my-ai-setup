+// Ben's seven known mods, installed as folders in <config>/mods (matched by the end of the
+// path), so their rows show: the pane lists a known mod only when it is found on disk.
+const KNOWN = ['cache-clock', 'handoff', 'screen-share', 'brain-dump', 'reflect', 'helper-desk', 'chat-inventory']
+const knownDisk: Record<string, string> = Object.fromEntries(
+  KNOWN.flatMap(n => [
