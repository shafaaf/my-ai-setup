+const knownAt = (path: string) => Object.keys(knownDisk).find(k => path.endsWith(k))
+// The fs.exists, fs.read and fs.list hooks of a machine with only the known mods, plus `files`.
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+function installKnown(on: any, files: Record<string, string>) {
+  on('fs.exists', async ($: unknown, e: { path: string }) => ({ value: e.path in files || knownAt(e.path) !== undefined }) as never)
+  on('fs.read', async ($: unknown, e: { path: string }) => {
+    if (e.path in files) return { value: files[e.path] } as never
+    const k = knownAt(e.path)
+    if (k === undefined) throw new Error(`ENOENT ${e.path}`)
+    return { value: knownDisk[k] } as never
+  })
+  on('fs.list', async ($: unknown, e: { path?: string }) => {
+    const path = (e.path ?? '').replace(/\/+$/, '')
+    if (path.endsWith('/mods')) return { value: KNOWN.map(name => ({ name, kind: 'dir', size: 0, mtimeMs: 0, isLink: false })) } as never
+    if (KNOWN.some(n => path.endsWith(`/mods/${n}/hooks`))) return { value: ['hooks.json', 'register.tsx'].map(name => ({ name, kind: 'file', size: 10, mtimeMs: 0, isLink: false })) } as never
+    return { value: [] } as never
+  })
+}
