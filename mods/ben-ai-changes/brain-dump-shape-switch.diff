+    if (await $.fs.exists(path)) json = JSON.parse(String(await $.fs.read(path))) as Record<string, unknown>
+  } catch {
+    json = {}
+  }
+  if (turnOn) delete json[NAME]
+  else json[NAME] = false
+  await mkdirs($, dir)
+  await $.fs.write(path, `${JSON.stringify(json, null, 2)}\n`)
+  off = !turnOn
+}
