+// [Shafaaf 1.0.2] Read the sidebar title from the desktop app's session file
+// (renames show within 30 s). Outside the desktop app, keep Nate's label.
+async function readTitle($) {
+  if (!T.hostId || !home || now - T.readAt < 30000) return
+  T.readAt = now
+  try {
+    if (!T.file) {
+      const root = `${home}/Library/Application Support/Claude/claude-code-sessions`
+      for (const a of await $.fs.list(root)) {
+        if (a.kind !== 'dir') continue
+        for (const b of await $.fs.list(`${root}/${a.name}`)) {
+          if (b.kind !== 'dir') continue
+          const file = `${root}/${a.name}/${b.name}/${T.hostId}.json`
+          if (await $.fs.exists(file)) { T.file = file; break }
+        }
+        if (T.file) break
+      }
+    }
+    if (!T.file) return
+    const data = JSON.parse(await $.fs.read(T.file))
+    const title = data && typeof data.title === 'string' ? data.title.trim() : ''
+    T.title = title && title !== 'New session' ? title : ''
+  } catch {
+    // no desktop session file: keep Nate's folder + first-prompt label
+  }
+}
